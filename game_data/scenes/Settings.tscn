bbcode_enabled = true
text = "[b][font_size=40] Enemy Selector: [/font_size][/b] 
[font_size=30] - Choose your opponents [/font_size]
[b][font_size=40] Party/Deck Selector: [/font_size][/b] 
[font_size=30] - Select your current deck, known as a party. There are two read-only presets and one editable deck for you to play with. [/font_size]
[font_size=30] - When in the deck selector, the blue highlighted deck is the currently active deck. [/font_size]
[font_size=30] - If you change the characters in a deck, be sure to clear the cards out and re-enter them to fix them to your new characters. [/font_size]
[font_size=30] - When making any changes, make sure to save, you cannot select a party until you have saved! [/font_size]

"

[node name="RichTextLabel2" type="RichTextLabel" parent="tab_container/Welcome" unique_id=1164688196]
layout_mode = 0
offset_left = 1074.0
offset_top = 368.0
offset_right = 1620.0
offset_bottom = 950.0
bbcode_enabled = true
text = "[b][font_size=40] What Makes a Party?: [/font_size][/b] 
[font_size=30] - Parties have 4 characters, whose stats are added together to sum the decks total stats. [/font_size]
[font_size=30] - Different characters provide differing amounts of slots for cards, which are filled by skill cards. [/font_size]
[font_size=30] - Skill cards make up the cards in your deck, which are played during a battle. [/font_size]
[font_size=30] - This playtest only includes one character of each class, each with one set of cards. [/font_size]

"

