[sub_resource type="Shader" id="Shader_hcqxf"]
code = "shader_type canvas_item;

uniform float exhausted_strength : hint_range(0.0, 1.0) = 0.0;
uniform float darken_amount : hint_range(0.0, 1.0) = 0.75;
uniform float desaturate_amount : hint_range(0.0, 1.0) = 0.75;

void fragment() {
	// COLOR already = texture * modulate
	float gray = dot(COLOR.rgb, vec3(0.299, 0.587, 0.114));
	vec3 desaturated = mix(COLOR.rgb, vec3(gray), desaturate_amount * exhausted_strength);
	vec3 darkened = desaturated * mix(1.0, darken_amount, exhausted_strength);

	COLOR.rgb = darkened;   // alpha is left untouched
}"

